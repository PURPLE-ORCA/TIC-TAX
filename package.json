{
  "name": "tic-tax",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src",
    "typecheck": "tsc --noEmit",
    "version:patch": "npm version patch --no-git-tag-version && echo 'Version bumped (patch)'",
    "version:minor": "npm version minor --no-git-tag-version && echo 'Version bumped (minor)'",
    "version:major": "npm version major --no-git-tag-version && echo 'Version bumped (major)'",
    "postinstall": "npm rebuild @shopify/react-native-skia"
  },
  "dependencies": {
    "@auth/core": "^0.34.3",
    "@convex-dev/auth": "^0.0.91",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@shopify/react-native-skia": "2.6.2",
    "buffer": "^6.0.3",
    "convex": "^1.35.1",
    "expo": "^56.0.0",
    "expo-constants": "~56.0.17",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.10",
    "expo-linking": "~56.0.13",
    "expo-navigation-bar": "~56.0.3",
    "expo-router": "~56.2.9",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "heroui-native": "1.0.1",
    "lottie-react-native": "^7.3.6",
    "lucide-react-native": "^1.8.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "tailwind-merge": "3.5.0",
    "tailwind-variants": "3.2.2",
    "uniwind": "1.6.2",
    "uuid": "^14.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "tailwindcss": "4.2.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "trustedDependencies": [
    "@shopify/react-native-skia",
    "esbuild",
    "msgpackr-extract",
    "unrs-resolver"
  ]
}
