{
  "name": "tic-tax",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src",
    "typecheck": "tsc --noEmit",
    "version:patch": "npm version patch --no-git-tag-version && echo 'Version bumped (patch)'",
    "version:minor": "npm version minor --no-git-tag-version && echo 'Version bumped (minor)'",
    "version:major": "npm version major --no-git-tag-version && echo 'Version bumped (major)'",
    "postinstall": "npm rebuild @shopify/react-native-skia"
  },
  "dependencies": {
    "@auth/core": "^0.34.3",
    "@convex-dev/auth": "^0.0.91",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@shopify/react-native-skia": "2.4.18",
    "buffer": "^6.0.3",
    "convex": "^1.35.1",
    "expo": "~55.0.15",
    "expo-constants": "~55.0.14",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.8",
    "expo-linking": "~55.0.13",
    "expo-navigation-bar": "^55.0.12",
    "expo-router": "~55.0.12",
    "expo-secure-store": "^55.0.13",
    "expo-splash-screen": "~55.0.18",
    "expo-sqlite": "^55.0.15",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.15",
    "expo-web-browser": "~55.0.14",
    "heroui-native": "1.0.1",
    "lottie-react-native": "^7.3.6",
    "lucide-react-native": "^1.8.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-mmkv": "^4.3.1",
    "react-native-reanimated": "4.2.1",
